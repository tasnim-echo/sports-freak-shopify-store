<section class="shop-by-sport">
  <div class="shop-by-sport__container">
    {% if section.settings.heading != blank %}
      <div class="shop-by-sport__header">
        <h2 class="shop-by-sport__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="
          shop-by-sport__grid
          shop-by-sport__grid--{{ section.settings.columns }}
        "
      >
        {% for block in section.blocks %}
          <a
            href="{{ block.settings.collection.url | default: '#' }}"
            class="shop-by-sport__card"
            {{ block.shopify_attributes }}
          >
            <div class="shop-by-sport__image-wrapper">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    widths: '300, 500, 700, 800',
                    sizes: '(max-width: 749px) 50vw, 33vw',
                    loading: 'lazy',
                    class: 'shop-by-sport__image'
                }}

              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'shop-by-sport__placeholder' }}
              {% endif %}

              <div class="shop-by-sport__overlay"></div>

              <div class="shop-by-sport__title">
                {{ block.settings.title }}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /*

========================================
SECTION
========================================
*/
  .shop-by-sport {
    margin-block: 40px;
  }
  .shop-by-sport__container {
    max-width: 1400px;

    margin: 0 auto;
  }

  /*

========================================
HEADER
========================================
*/

  .shop-by-sport__header {
    margin-bottom: 36px;

    text-align: center;
  }

  .shop-by-sport__heading {
    margin: 0;

    font-size: clamp(28px, 4vw, 48px);

    line-height: 1.1;
  }

  /*

========================================
GRID
========================================
*/

  .shop-by-sport__grid {
    display: grid;

    gap: 20px;
  }

  .shop-by-sport__grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .shop-by-sport__grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .shop-by-sport__grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  /*

========================================
CARD
========================================
*/

  .shop-by-sport__card {
    position: relative;

    display: block;

    overflow: hidden;

    color: inherit;

    text-decoration: none;

    aspect-ratio: 4 / 5;
  }

  /*

========================================
IMAGE
========================================
*/

  .shop-by-sport__image-wrapper {
    position: relative;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #f3f3f3;
  }

  .shop-by-sport__image,
  .shop-by-sport__placeholder {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    transition: transform 0.5s ease;
  }

  /*

========================================
OVERLAY
========================================
*/

  .shop-by-sport__overlay {
    position: absolute;

    inset: 0;

    background: #000;

    opacity: 0.25;

    transition: opacity 0.3s ease;
  }

  /*

========================================
TITLE
========================================
*/

  .shop-by-sport__title {
    position: absolute;

    left: 50%;
    bottom: 32px;

    transform: translateX(-50%);

    z-index: 1;

    width: calc(100% - 32px);

    text-align: center;

    color: #fff;

    font-size: 24px;

    font-weight: 700;

    letter-spacing: 0.5px;

    text-transform: uppercase;
  }

  /*

========================================
HOVER
========================================
*/

  .shop-by-sport__card .shop-by-sport__image {
    transform: scale(1.05);
  }

  .shop-by-sport__card .shop-by-sport__overlay {
    opacity: 0.4;
  }

  /*

========================================
MOBILE
========================================
*/

  @media screen and (max-width: 749px) {
    .shop-by-sport__header {
      margin-bottom: 24px;
    }

    .shop-by-sport__grid {
      gap: 12px;
    }

    .shop-by-sport__grid--4,
    .shop-by-sport__grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }

    .shop-by-sport__title {
      bottom: 20px;

      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Sport",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",

      "default": "SHOP BY SPORT"
    },

    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",

      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },

        {
          "value": "3",
          "label": "3 columns"
        },

        {
          "value": "4",
          "label": "4 columns"
        }
      ],

      "default": "4"
    }
  ],

  "blocks": [
    {
      "type": "sport",

      "name": "Sport",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Sport name",

          "default": "Football"
        },

        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Shop by Sport",

      "blocks": [
        {
          "type": "sport"
        },

        {
          "type": "sport"
        },

        {
          "type": "sport"
        },

        {
          "type": "sport"
        }
      ]
    }
  ]
}
{% endschema %}
