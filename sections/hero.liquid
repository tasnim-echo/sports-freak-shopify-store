<section
  class="hero full-width"
  style="--hero-height: {{ section.settings.height }}px;"
>
  <!-- Media -->

  <div class="hero__media ">
    {% if section.settings.media_type == 'video' and section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'hero__video'
      }}

    {% elsif section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', class: 'hero__image'
      }}
    {% endif %}
  </div>

  <!-- Overlay -->

  <div
    class="hero__overlay"
    style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  <!-- Content -->

  <div class="hero__content hero__content--{{ section.settings.text_alignment }}">
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="hero__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="hero__buttons">
      {% if section.settings.button_1_label != blank %}
        <a
          href="{{ section.settings.button_1_link }}"
          class="hero__button"
        >
          {{ section.settings.button_1_label }}
        </a>
      {% endif %}

      {% if section.settings.button_2_label != blank %}
        <a
          href="{{ section.settings.button_2_link }}"
          class="hero__button hero__button--secondary"
        >
          {{ section.settings.button_2_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;

    width: 100%;
    height: var(--hero-height, 650px);

    overflow: hidden;

    background: #111;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  /*

* MEDIA
  */

  .hero__media {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
  }

  .hero__image,
  .hero__video {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  /*

* OVERLAY
  */

  .hero__overlay {
    position: absolute;

    inset: 0;

    background: #000;

    opacity: var(--hero-overlay-opacity);
  }

  /*

* CONTENT
  */

  .hero__content {
    position: relative;

    z-index: 1;

    width: 100%;
    max-width: 850px;

    padding: 40px;

    color: #fff;
  }

  .hero__content--left {
    margin-right: auto;

    text-align: left;
  }

  .hero__content--center {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__content--right {
    margin-left: auto;

    text-align: right;
  }

  /*

* HEADING
  */

  .hero__heading {
    margin: 0 0 18px;

    font-size: clamp(40px, 6vw, 80px);

    line-height: 1;

    font-weight: 700;
  }

  /*

* DESCRIPTION
  */

  .hero__description {
    max-width: 650px;

    margin-bottom: 28px;

    font-size: 18px;

    line-height: 1.5;
  }

  /*

* BUTTONS
  */

  .hero__buttons {
    display: flex;

    align-items: center;

    gap: 12px;
  }

  .hero__content--center .hero__buttons {
    justify-content: center;
  }

  .hero__content--right .hero__buttons {
    justify-content: flex-end;
  }

  .hero__button {
    min-width: 150px;

    padding: 14px 24px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    background: #fff;

    color: #111;

    text-decoration: none;

    font-size: 14px;

    font-weight: 600;
  }

  .hero__button--secondary {
    background: transparent;

    color: #fff;

    border: 1px solid #fff;
  }

  /*

* MOBILE
  */

  @media screen and (max-width: 749px) {
    .hero {
      height: var(--hero-height, 550px);
    }

    .hero__content {
      padding: 32px 20px;
    }

    .hero__heading {
      font-size: clamp(36px, 11vw, 56px);
    }

    .hero__description {
      font-size: 16px;
    }

    .hero__buttons {
      flex-direction: column;

      align-items: stretch;
    }

    .hero__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",

  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",

      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],

      "default": "image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },

    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",

      "default": "PLAY YOUR GAME"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",

      "default": "Everything you need to perform at your best."
    },

    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",

      "default": "SHOP NOW"
    },

    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },

    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",

      "default": "EXPLORE"
    },

    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",

      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],

      "default": "center"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",

      "min": 0,
      "max": 80,
      "step": 5,

      "unit": "%",

      "default": 35
    },

    {
      "type": "range",
      "id": "height",
      "label": "Height",

      "min": 400,
      "max": 800,
      "step": 50,

      "unit": "px",

      "default": 650
    }
  ],

  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
