<section
  class="promo-banner"
  style="--promo-banner-height: {{ section.settings.height }}px;"
>
  {% if section.settings.image != blank %}
    <div class="promo-banner__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'promo-banner__image'
      }}
    </div>
  {% endif %}

  <div
    class="promo-banner__overlay"
    style="--promo-banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  <div class="promo-banner__content promo-banner__content--{{ section.settings.text_alignment }}">
    {% if section.settings.eyebrow != blank %}
      <p class="promo-banner__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="promo-banner__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="promo-banner__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.collection != blank %}
      <a
        href="{{ section.settings.collection.url }}"
        class="promo-banner__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% elsif section.settings.button_label != blank and section.settings.button_link != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="promo-banner__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .promo-banner {
    position: relative;
    width: 100%;
    height: var(--promo-banner-height, 500px);
    overflow: hidden;
    background: #111;
    display: flex;
    align-items: center;
  }

  .promo-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .promo-banner__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .promo-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: var(--promo-banner-overlay);
  }

  .promo-banner__content {
    position: relative;
    z-index: 2;
    width: min(800px, calc(100% - 40px));
    padding: 40px;
    color: #fff;
  }

  .promo-banner__content--left {
    margin-right: auto;
    text-align: left;
  }

  .promo-banner__content--center {
    margin: 0 auto;
    text-align: center;
  }

  .promo-banner__content--right {
    margin-left: auto;
    text-align: right;
  }

  .promo-banner__eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .promo-banner__heading {
    margin: 0 0 18px;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    font-weight: 700;
  }

  .promo-banner__description {
    max-width: 600px;
    margin-bottom: 28px;
    font-size: 18px;
    line-height: 1.5;
  }

  .promo-banner__content--center .promo-banner__description {
    margin-left: auto;
    margin-right: auto;
  }

  .promo-banner__content--right .promo-banner__description {
    margin-left: auto;
  }

  .promo-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    padding: 14px 26px;
    background: #fff;
    color: #111;
    text-decoration: none;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .promo-banner__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .promo-banner {
      height: var(--promo-banner-height, 450px);
    }

    .promo-banner__content {
      width: calc(100% - 32px);
      padding: 24px 16px;
    }

    .promo-banner__heading {
      font-size: clamp(36px, 11vw, 54px);
    }

    .promo-banner__description {
      font-size: 16px;
    }

    .promo-banner__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Built for athletes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TRAIN HARDER. PLAY BETTER."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Gear built to help you perform at your best."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Custom button link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 300,
      "max": 700,
      "step": 50,
      "unit": "px",
      "default": 500
    }
  ],
  "presets": [
    {
      "name": "Promo Banner",
      "settings": {
        "eyebrow": "Built for athletes",
        "heading": "TRAIN HARDER. PLAY BETTER.",
        "description": "Gear built to help you perform at your best.",
        "button_label": "SHOP NOW",
        "text_alignment": "center",
        "overlay_opacity": 40,
        "height": 500
      }
    }
  ]
}
{% endschema %}
