<section class="cart-page">
  <div class="cart-page__container">
    <h1 class="cart-page__title">Your cart</h1>

    {% if cart.item_count > 0 %}
      <div id="CartPageContent" class="cart-page__content">
        <!-- Cart Items -->
        <div class="cart-page__items">
          {% for item in cart.items %}
            <div
              class="cart-page__item"
              data-line="{{ forloop.index }}"
            >
              <!-- Image -->
              <div class="cart-page__item-image">
                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 300 }}"
                    alt="{{ item.image.alt | escape }}"
                    width="150"
                    height="150"
                    loading="lazy"
                  >
                {% endif %}
              </div>

              <!-- Details -->
              <div class="cart-page__item-details">
                <h2 class="cart-page__item-title">
                  <a href="{{ item.url }}">
                    {{ item.product.title }}
                  </a>
                </h2>

                {% unless item.product.has_only_default_variant %}
                  <p class="cart-page__item-variant">
                    {{ item.variant.title }}
                  </p>
                {% endunless %}

                <p class="cart-page__item-price">
                  {{ item.final_price | money }}
                </p>

                <!-- Quantity -->
                <div class="cart-page__quantity">
                  <button
                    type="button"
                    class="cart-page__quantity-button"
                    data-line="{{ forloop.index }}"
                    data-action="decrease"
                    aria-label="Decrease quantity"
                  >
                    −
                  </button>

                  <span class="cart-page__quantity-value">
                    {{ item.quantity }}
                  </span>

                  <button
                    type="button"
                    class="cart-page__quantity-button"
                    data-line="{{ forloop.index }}"
                    data-action="increase"
                    aria-label="Increase quantity"
                  >
                    +
                  </button>
                </div>

                <button
                  type="button"
                  class="cart-page__remove"
                  data-line="{{ forloop.index }}"
                >
                  Remove
                </button>
              </div>

              <!-- Line Total -->
              <div class="cart-page__item-total">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Summary -->
        <aside class="cart-page__summary">
          <div class="cart-page__subtotal">
            <span>Subtotal</span>

            <strong>
              {{ cart.total_price | money }}
            </strong>
          </div>

          <p class="cart-page__tax-note">Taxes and shipping calculated at checkout.</p>

          <form
            action="{{ routes.cart_url }}"
            method="post"
          >
            <button
              type="submit"
              name="checkout"
              class="cart-page__checkout"
            >
              Checkout
            </button>
          </form>

          <a
            href="{{ routes.all_products_collection_url }}"
            class="cart-page__continue"
          >
            Continue shopping
          </a>
        </aside>
      </div>

    {% else %}
      <!-- Empty Cart -->
      <div class="cart-page__empty">
        <p>Your cart is currently empty.</p>

        <a
          href="{{ routes.all_products_collection_url }}"
          class="cart-page__continue"
        >
          Continue shopping
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cart-page {
    width: 100%;
    padding: 60px 0 80px;
  }

  .cart-page__container {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
  }

  .cart-page__title {
    margin: 0 0 40px;
    font-size: 32px;
    font-weight: 600;
  }

  .cart-page__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 50px;
  }

  /* Cart Items */

  .cart-page__items {
    display: flex;
    flex-direction: column;
  }

  .cart-page__item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .cart-page__item-image {
    width: 150px;
    height: 150px;
    background: #f5f5f5;
  }

  .cart-page__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-page__item-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .cart-page__item-title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
  }

  .cart-page__item-title a {
    color: inherit;
    text-decoration: none;
  }

  .cart-page__item-variant {
    margin: 0 0 8px;
    font-size: 14px;
    color: #666;
  }

  .cart-page__item-price {
    margin: 0 0 15px;
    font-size: 15px;
  }

  /* Quantity */

  .cart-page__quantity {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
  }

  .cart-page__quantity-button {
    width: 32px;
    height: 32px;
    border: 0;
    background: #fff;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-page__quantity-value {
    min-width: 35px;
    text-align: center;
    font-size: 14px;
  }

  /* Remove */

  .cart-page__remove {
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: none;
    text-decoration: underline;
    cursor: pointer;
    font-size: 13px;
  }

  /* Line Total */

  .cart-page__item-total {
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Summary */

  .cart-page__summary {
    padding: 25px;
    border: 1px solid #e5e5e5;
    align-self: start;
  }

  .cart-page__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    font-size: 18px;
  }

  .cart-page__tax-note {
    margin: 0 0 25px;
    font-size: 13px;
    color: #666;
    line-height: 1.5;
  }

  .cart-page__checkout {
    width: 100%;
    min-height: 48px;
    border: 0;
    background: #111;
    color: #fff;
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
  }

  .cart-page__continue {
    display: block;
    margin-top: 15px;
    text-align: center;
    color: #111;
    font-size: 14px;
  }

  /* Empty Cart */

  .cart-page__empty {
    padding: 80px 20px;
    text-align: center;
  }

  .cart-page__empty p {
    margin: 0 0 25px;
    font-size: 18px;
  }

  /* Mobile */

  @media (max-width: 767px) {
    .cart-page {
      padding: 40px 0 60px;
    }

    .cart-page__title {
      margin-bottom: 25px;
      font-size: 26px;
    }

    .cart-page__content {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .cart-page__item {
      grid-template-columns: 90px minmax(0, 1fr);
      gap: 15px;
    }

    .cart-page__item-image {
      width: 90px;
      height: 90px;
    }

    .cart-page__item-total {
      grid-column: 2;
    }

    .cart-page__summary {
      width: 100%;
    }
  }
{% endstylesheet %}

<script>
  document.addEventListener('click', async (event) => {
    const button = event.target.closest('.cart-page__quantity-button, .cart-page__remove');

    if (!button) {
      return;
    }

    const line = button.dataset.line;

    if (!line) {
      return;
    }

    const item = button.closest('.cart-page__item');

    const quantityElement = item?.querySelector('.cart-page__quantity-value');

    const currentQuantity = quantityElement ? parseInt(quantityElement.textContent.trim(), 10) : 1;

    let newQuantity;

    if (button.dataset.action === 'increase') {
      newQuantity = currentQuantity + 1;
    } else if (button.dataset.action === 'decrease') {
      newQuantity = currentQuantity - 1;
    } else {
      newQuantity = 0;
    }

    if (button.dataset.action === 'decrease' && newQuantity < 1) {
      return;
    }

    try {
      /*
       * 1. Update Shopify cart
       */
      const response = await fetch(`${window.Shopify.routes.root}cart/change.js`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          line: Number(line),
          quantity: newQuantity,
        }),
      });

      if (!response.ok) {
        throw new Error('Failed to update cart');
      }

      await response.json();

      /*
       * 2. Refresh cart page
       */
      const pageResponse = await fetch(`${window.Shopify.routes.root}cart`);

      if (!pageResponse.ok) {
        throw new Error('Failed to refresh cart page');
      }

      const html = await pageResponse.text();

      const parser = new DOMParser();

      const newDocument = parser.parseFromString(html, 'text/html');

      const newCartPage = newDocument.querySelector('.cart-page');

      const currentCartPage = document.querySelector('.cart-page');

      if (!newCartPage || !currentCartPage) {
        throw new Error('Cart page not found');
      }

      /*
       * Replace cart page
       */
      currentCartPage.replaceWith(newCartPage);

      /*
       * 3. Refresh header and cart drawer
       */
      if (typeof window.refreshCartDrawer !== 'function') {
        throw new Error('Cart drawer is not initialized');
      }

      await window.refreshCartDrawer({ open: true });
    } catch (error) {
      console.error('Cart update error:', error);
    }
  });
</script>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
