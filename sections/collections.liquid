{{ 'main-list-collections.css' | asset_url | stylesheet_tag }}

<section class="main-collections">
  <div class="main-collections__header">
    <span class="main-collections__eyebrow">EXPLORE OUR WORLD</span>
    <h1 class="main-collections__title">
      {{ section.settings.heading }}
    </h1>
    <p class="main-collections__description">
      {{ section.settings.description }}
    </p>
  </div>

  <div class="main-collections__grid">
    {% for collection in collections %}
      <a href="{{ collection.url }}" class="main-collections__card">
        <div class="main-collections__image">
          {% if collection.featured_image != blank %}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}

          <div class="main-collections__overlay">
            <span>Explore Collection</span>
            <span class="main-collections__arrow">↗</span>
          </div>
        </div>

        <div class="main-collections__content">
          <div>
            <h2>{{ collection.title }}</h2>

            {% if collection.description != blank %}
              <p>
                {{ collection.description | strip_html | truncatewords: 18 }}
              </p>
            {% else %}
              <p>Explore our {{ collection.title | downcase }} collection.</p>
            {% endif %}
          </div>

          <span class="main-collections__link">→</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Main Collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover collections thoughtfully curated for your lifestyle."
    }
  ],
  "presets": [
    {
      "name": "Main Collections"
    }
  ]
}
{% endschema %}
