<div
  class="announcement-bar full-width"
  style="
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-color: {{ section.settings.text_color }};
    --announcement-speed: {{ section.settings.speed }}s;
    --announcement-gap: {{ section.settings.gap }}px;
  "
>
  <div class="announcement-bar__track">
    <div class="announcement-bar__content">
      <span>{{ section.settings.text }}</span>
      <span>{{ section.settings.text }}</span>
      <span>{{ section.settings.text }}</span>
      <span>{{ section.settings.text }}</span>
    </div>

    <div class="announcement-bar__content">
      <span>{{ section.settings.text }}</span>
      <span>{{ section.settings.text }}</span>
      <span>{{ section.settings.text }}</span>
      <span>{{ section.settings.text }}</span>
    </div>
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    overflow: hidden;
    background: var(--announcement-bg);
    color: var(--announcement-color);
    padding-block: 10px;
  }

  .announcement-bar__track {
    display: flex;
    width: max-content;
    animation: announcement-marquee var(--announcement-speed) linear infinite;
  }

  .announcement-bar__content {
    display: flex;
    gap: var(--announcement-gap);
    padding-right: var(--announcement-gap);
    white-space: nowrap;
  }

  .announcement-bar:hover .announcement-bar__track {
    animation-play-state: paused;
  }

  @keyframes announcement-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "FREE SHIPPING ON ORDERS OVER $50"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Message gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
