{{ 'main-search.css' | asset_url | stylesheet_tag }}

<section class="main-search">
  <div class="main-search__header">
    <span class="main-search__eyebrow">DISCOVER OUR COLLECTION</span>
    <h1 class="main-search__title">Search</h1>
    <p class="main-search__description">Find exactly what you're looking for.</p>

    <form action="{{ routes.search_url }}" method="get" role="search" class="main-search__form">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products, articles..."
        aria-label="Search"
      >

      <input type="hidden" name="options[prefix]" value="last">

      <button type="submit" aria-label="Submit search">
        {{ 'icon-search-submit.svg' | inline_asset_content }}
      </button>
    </form>
  </div>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <div class="main-search__empty">
        <div class="main-search__empty-icon">
          {{ 'icon-search-empty.svg' | inline_asset_content }}
        </div>

        <h2>No results found</h2>
        <p>We couldn't find anything for "{{ search.terms | escape }}". Try another search or check your spelling.</p>

        <a href="{{ routes.all_products_collection_url }}" class="main-search__back-button"> Explore Products → </a>
      </div>

    {% else %}
      <div class="main-search__results-header">
        <div>
          <h2>Search Results</h2>
          <p>
            {{ search.results_count }} results for
            <strong>"{{ search.terms | escape }}"</strong>
          </p>
        </div>
      </div>

      {% paginate search.results by 16 %}
        <div class="main-search__grid">
          {% for result in search.results %}
            {% assign featured_image = result.featured_image | default: result.image %}

            <a href="{{ result.url }}" class="main-search__card">
              <div class="main-search__card-image">
                {% if featured_image != blank %}
                  {{ featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: result.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}

                {% unless result.object_type == 'product' %}
                  <span class="main-search__type">
                    {{ result.object_type }}
                  </span>
                {% endunless %}
              </div>

              <div class="main-search__card-content">
                <h3>{{ result.title }}</h3>

                {% if result.object_type == 'product' %}
                  <p class="main-search__price">
                    {% if result.price_varies %}
                      From {{ result.price_min | money }}
                    {% else %}
                      {{ result.price | money }}
                    {% endif %}
                  </p>
                {% else %}
                  <p class="main-search__read-more">Read more →</p>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="main-search__pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Main Search",
  "settings": [],
  "presets": [
    {
      "name": "Main Search"
    }
  ]
}
{% endschema %}
