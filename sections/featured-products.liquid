<section class="featured-products">
  <div class="featured-products__container">
    <div class="featured-products__header">
      {% if section.settings.heading != blank %}
        <h2 class="featured-products__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <div class="featured-products__slider">
        <div class="swiper featured-products__swiper">
          <div class="swiper-wrapper">
            {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
              <div class="swiper-slide">
                <article class="product-card">
                  <a
                    href="{{ product.url }}"
                    class="product-card__link"
                  >
                    <div class="product-card__image-wrapper">
                      {% if product.featured_image != blank %}
                        {{
                          product.featured_image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '300, 500, 700, 800',
                            sizes: '(max-width: 749px) 80vw, 25vw',
                            class: 'product-card__image'
                        }}

                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
                      {% endif %}
                    </div>

                    <div class="product-card__info">
                      <h3 class="product-card__title">
                        {{ product.title }}
                      </h3>

                      <div class="product-card__price">
                        {% if product.compare_at_price > product.price %}
                          <span class="product-card__price--sale">
                            {{ product.price | money }}
                          </span>

                          <span class="product-card__price--compare">
                            {{ product.compare_at_price | money }}
                          </span>

                        {% else %}
                          <span>
                            {{ product.price | money }}
                          </span>
                        {% endif %}
                      </div>
                    </div>
                  </a>
                </article>
              </div>
            {% endfor %}
          </div>
        </div>

        <button
          type="button"
          class="featured-products__arrow featured-products__arrow--prev"
          aria-label="Previous products"
        >
          ←
        </button>

        <button
          type="button"
          class="featured-products__arrow featured-products__arrow--next"
          aria-label="Next products"
        >
          →
        </button>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .featured-products {
    width: 100%;
    padding: 80px 0;
  }

  .featured-products__container {
    width: min(1400px, calc(100% - 40px));
    margin: 0 auto;
  }

  .featured-products__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .featured-products__heading {
    margin: 0;
    font-size: 36px;
    line-height: 1.1;
    font-weight: 700;
  }

  .featured-products__view-all {
    color: #111;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .featured-products__slider {
    position: relative;
  }

  .featured-products__swiper {
    width: 100%;
    overflow: hidden;
  }

  .featured-products__swiper .swiper-wrapper {
    display: flex;
  }

  .featured-products__swiper .swiper-slide {
    height: auto;
  }

  .product-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .product-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .product-card__image,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.04);
  }

  .product-card__info {
    padding-top: 14px;
  }

  .product-card__title {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 500;
  }

  .product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
  }

  .product-card__price--sale {
    font-weight: 600;
  }

  .product-card__price--compare {
    color: #777;
    text-decoration: line-through;
  }

  .featured-products__arrow {
    position: absolute;
    top: 40%;
    z-index: 2;

    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #ddd;
    border-radius: 50%;
    background: #fff;
    color: #111;

    cursor: pointer;

    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .featured-products__arrow--prev {
    left: -22px;
  }

  .featured-products__arrow--next {
    right: -22px;
  }

  @media screen and (max-width: 749px) {
    .featured-products {
      padding: 60px 0;
    }

    .featured-products__container {
      width: calc(100% - 32px);
    }

    .featured-products__heading {
      font-size: 28px;
    }

    .featured-products__swiper .swiper-slide {
      width: 80%;
    }

    .featured-products__arrow {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
    const swiperCSS = document.createElement('link');

    swiperCSS.rel = 'stylesheet';
    swiperCSS.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';

    document.head.appendChild(swiperCSS);
  }

  function initFeaturedProducts() {
    document.querySelectorAll('.featured-products__swiper').forEach((slider) => {
      if (slider.swiper) return;

      const section = slider.closest('.featured-products');

      const prevButton = section.querySelector('.featured-products__arrow--prev');

      const nextButton = section.querySelector('.featured-products__arrow--next');

      new Swiper(slider, {
        slidesPerView: 1.15,
        spaceBetween: 16,

        navigation: {
          prevEl: prevButton,
          nextEl: nextButton,
        },

        breakpoints: {
          750: {
            slidesPerView: 3,
            spaceBetween: 20,
          },

          990: {
            slidesPerView: 4,
            spaceBetween: 20,
          },
        },
      });
    });
  }

  if (typeof Swiper === 'undefined') {
    const swiperScript = document.createElement('script');

    swiperScript.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';

    swiperScript.onload = initFeaturedProducts;

    document.head.appendChild(swiperScript);
  } else {
    initFeaturedProducts();
  }
{% endjavascript %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "heading": "Featured Products",
        "collection": "hydrogen",
        "products_to_show": 8
      }
    }
  ]
}
{% endschema %}
