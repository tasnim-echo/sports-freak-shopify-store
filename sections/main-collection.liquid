{{ 'pagination.css' | asset_url | stylesheet_tag }}
<section class="main-collection">
  <div class="main-collection__container">
    <header class="main-collection__header">
      {% if collection.title != blank %}
        <h1 class="main-collection__title">
          {{ collection.title }}
        </h1>
      {% endif %}

      {% if collection.description != blank %}
        <div class="main-collection__description">
          {{ collection.description }}
        </div>
      {% endif %}

      <p class="main-collection__count">{{ collection.products_count }} products</p>
    </header>

    <div class="main-collection__content">
      {% comment %} FILTERS {% endcomment %}

      {% if collection.filters.size > 0 %}
        <!-- Mobile filter button -->
        <button
          type="button"
          class="collection-filters__mobile-button"
          id="CollectionFilterOpen"
        >
          Filter
        </button>

        <!-- Overlay -->
        <div
          class="collection-filters__overlay"
          id="CollectionFilterOverlay"
        ></div>

        <form
          method="get"
          action="{{ collection.url }}"
          class="collection-filters"
          id="CollectionFilters"
        >
          <div class="collection-filters__header">
            <h2>Filter</h2>

            <a href="{{ collection.url }}"> Clear all </a>

            <!-- Mobile close button -->
            <button
              type="button"
              class="collection-filters__close"
              id="CollectionFilterClose"
              aria-label="Close filters"
            >
              ×
            </button>
          </div>

          {% for filter in collection.filters %}
            <details class="collection-filter">
              <summary class="collection-filter__title">
                <span>
                  {{ filter.label }}
                </span>

                <span> + </span>
              </summary>

              <div class="collection-filter__options">
                {% case filter.type %}
                  {% when 'boolean', 'list' %}
                    {% for value in filter.values %}
                      <label class="collection-filter__option">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}
                            checked
                          {% endif %}
                        >

                        <span>
                          {{ value.label }}
                        </span>

                        <span>
                          {{ value.count }}
                        </span>
                      </label>
                    {% endfor %}

                  {% when 'price_range' %}
                    <div class="collection-filter__price">
                      {% if filter.min_value %}
                        <div>
                          <label
                            for="Filter-{{ filter.min_value.param_name }}"
                          >
                            From
                          </label>

                          <input
                            id="Filter-{{ filter.min_value.param_name }}"
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | default: '' }}"
                            placeholder="0"
                          >
                        </div>
                      {% endif %}

                      {% if filter.max_value %}
                        <div>
                          <label
                            for="Filter-{{ filter.max_value.param_name }}"
                          >
                            To
                          </label>

                          <input
                            id="Filter-{{ filter.max_value.param_name }}"
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | default: '' }}"
                            placeholder="{{ filter.range_max | money_without_currency }}"
                          >
                        </div>
                      {% endif %}
                    </div>
                {% endcase %}
              </div>
            </details>
          {% endfor %}

          <button
            type="submit"
            class="collection-filters__apply"
          >
            Apply filters
          </button>
        </form>
      {% endif %}

      {% comment %} PRODUCTS {% endcomment %}

      <div class="main-collection__products">
        {% paginate collection.products by 8 %}
          <div class="main-collection__grid">
            {% for product in collection.products %}
              <article class="collection-product-card">
                <a
                  href="{{ product.url }}"
                  class="collection-product-card__link"
                >
                  <div class="collection-product-card__image-wrapper">
                    {% if product.featured_image != blank %}
                      {{
                        product.featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 500, 700, 800',
                          sizes: '(max-width: 749px) 50vw, 25vw',
                          class: 'collection-product-card__image'
                      }}

                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}
                  </div>

                  <div class="collection-product-card__info">
                    <h2 class="collection-product-card__title">
                      {{ product.title }}
                    </h2>

                    <div class="collection-product-card__price">
                      {% if product.compare_at_price > product.price %}
                        <span class="collection-product-card__price--sale">
                          {{ product.price | money }}
                        </span>

                        <span class="collection-product-card__price--compare">
                          {{ product.compare_at_price | money }}
                        </span>

                      {% else %}
                        <span>
                          {{ product.price | money }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </a>
              </article>

            {% else %}
              <p>No products found.</p>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}">Previous</a>
              {% endif %}

              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}">
                    {{ part.title }}
                  </a>
                {% else %}
                  <span>
                    {{ part.title }}
                  </span>
                {% endif %}
              {% endfor %}

              {% if paginate.next %}
                <a href="{{ paginate.next.url }}">Next</a>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .main-collection {
    width: 100%;
    padding: 60px 0 80px;
  }

  .main-collection__container {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
  }

  .main-collection__header {
    margin-bottom: 40px;
    text-align: center;
  }

  .main-collection__title {
    margin: 0 0 16px;
    font-size: 42px;
    line-height: 1.1;
    font-weight: 700;
  }

  .main-collection__description {
    max-width: 700px;
    margin: 0 auto 12px;
    font-size: 16px;
    line-height: 1.5;
    color: #666;
  }

  .main-collection__count {
    margin: 0;
    font-size: 14px;
    color: #777;
  }

  .main-collection__content {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  .main-collection__products {
    min-width: 0;
  }

  .main-collection__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 20px;
  }

  .collection-product-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .collection-product-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .collection-product-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .collection-product-card__link:hover .collection-product-card__image {
    transform: scale(1.04);
  }

  .collection-product-card__info {
    padding-top: 14px;
  }

  .collection-product-card__title {
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
  }

  .collection-product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .collection-product-card__price--sale {
    font-weight: 600;
  }

  .collection-product-card__price--compare {
    color: #888;
    text-decoration: line-through;
  }

  .collection-filters {
    width: 280px;
    flex-shrink: 0;

    border: 1px solid #e5e5e5;
    background: #fff;
  }

  .collection-filters__header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 20px;

    border-bottom: 1px solid #e5e5e5;
  }

  .collection-filters__header h2 {
    margin: 0;

    font-size: 18px;
    line-height: 1.2;
    font-weight: 600;
  }

  .collection-filters__header a {
    color: #666;

    font-size: 13px;

    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .collection-filter {
    border-bottom: 1px solid #e5e5e5;
  }

  .collection-filter:last-of-type {
    border-bottom: none;
  }

  .collection-filter__title {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 20px;

    cursor: pointer;
    list-style: none;

    font-size: 15px;
    font-weight: 600;
  }

  .collection-filter__title::-webkit-details-marker {
    display: none;
  }

  .collection-filter__title span:last-child {
    font-size: 20px;
    font-weight: 400;
    line-height: 1;

    transition: transform 0.2s ease;
  }

  .collection-filter[open] .collection-filter__title span:last-child {
    transform: rotate(45deg);
  }

  .collection-filter__options {
    padding: 0 20px 18px;
  }

  .collection-filter__option {
    display: flex;
    align-items: center;

    gap: 10px;
    padding: 7px 0;

    cursor: pointer;

    font-size: 14px;
    line-height: 1.4;
  }

  .collection-filter__option input {
    width: 16px;
    height: 16px;

    margin: 0;

    flex-shrink: 0;

    cursor: pointer;

    accent-color: #111;
  }

  .collection-filter__option span:nth-child(2) {
    flex: 1;
  }

  .collection-filter__option span:last-child {
    color: #888;
    font-size: 12px;
  }

  .collection-filter__price {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 10px;
  }

  .collection-filter__price label {
    display: block;

    margin-bottom: 6px;

    color: #666;

    font-size: 12px;
  }

  .collection-filter__price input {
    width: 100%;
    height: 40px;

    padding: 0 10px;

    box-sizing: border-box;

    border: 1px solid #d9d9d9;

    background: #fff;

    font-size: 13px;
  }

  .collection-filter__price input:focus {
    outline: none;
    border-color: #111;
  }

  .collection-filters__apply {
    width: calc(100% - 40px);

    margin: 20px;

    padding: 13px 20px;

    border: 1px solid #111;

    background: #111;
    color: #fff;

    cursor: pointer;

    font-size: 14px;
    font-weight: 600;

    transition: background 0.2s ease;
  }

  .collection-filters__apply:hover {
    background: #333;
  }

  .collection-filters__mobile-button,
  .collection-filters__close,
  .collection-filters__overlay {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .main-collection__content {
      grid-template-columns: 240px minmax(0, 1fr);

      gap: 24px;
    }

    .collection-filters {
      width: 240px;
    }

    .main-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .main-collection {
      padding: 40px 0 60px;
    }

    .main-collection__container {
      width: calc(100% - 32px);
    }

    /* Header */

    .main-collection__header {
      margin-bottom: 30px;
    }

    .main-collection__title {
      font-size: 32px;
    }

    /* Content */

    .main-collection__content {
      display: block;
    }

    .collection-filters__mobile-button {
      display: flex;

      align-items: center;
      justify-content: center;

      width: 100%;
      height: 48px;

      margin-bottom: 20px;

      border: 1px solid #111;

      background: #fff;
      color: #111;

      cursor: pointer;

      font-size: 14px;
      font-weight: 600;
    }

    .collection-filters {
      position: fixed;

      top: 0;
      left: 0;

      width: 85%;
      max-width: 380px;
      height: 100vh;

      margin: 0;

      background: #fff;

      z-index: 1001;

      overflow-y: auto;

      transform: translateX(-100%);

      visibility: hidden;

      transition: transform 0.3s ease, visibility 0.3s ease;
    }

    .collection-filters.is-open {
      transform: translateX(0);

      visibility: visible;
    }

    .collection-filters__header {
      position: sticky;

      top: 0;

      z-index: 2;

      display: flex;

      align-items: center;
      justify-content: space-between;

      padding: 18px 16px;

      background: #fff;

      border-bottom: 1px solid #e5e5e5;
    }

    .collection-filters__header h2 {
      font-size: 18px;
    }

    /* Close button */

    .collection-filters__close {
      display: flex;

      align-items: center;
      justify-content: center;

      width: 32px;
      height: 32px;

      padding: 0;

      border: none;

      background: transparent;

      color: #111;

      cursor: pointer;

      font-size: 28px;
      font-weight: 300;

      line-height: 1;
    }

    .collection-filter__title {
      padding: 18px 16px;
    }

    .collection-filter__options {
      padding: 0 16px 18px;
    }

    .collection-filters__apply {
      position: sticky;

      bottom: 0;

      width: calc(100% - 32px);

      margin: 16px;

      padding: 14px 20px;

      border: 1px solid #111;

      background: #111;

      color: #fff;

      font-size: 14px;
      font-weight: 600;

      cursor: pointer;
    }

    .collection-filters__overlay {
      display: block;

      position: fixed;

      inset: 0;

      z-index: 1000;

      background: rgba(0, 0, 0, 0.45);

      opacity: 0;

      visibility: hidden;

      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .collection-filters__overlay.is-visible {
      opacity: 1;

      visibility: visible;
    }

    .main-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 28px 12px;
    }

    .collection-product-card__title {
      font-size: 14px;
    }

    .collection-pagination {
      margin-top: 40px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const filterDrawer = document.querySelector('#CollectionFilters');
    const filterOpen = document.querySelector('#CollectionFilterOpen');
    const filterClose = document.querySelector('#CollectionFilterClose');
    const filterOverlay = document.querySelector('#CollectionFilterOverlay');

    if (!filterDrawer || !filterOpen || !filterClose || !filterOverlay) {
      return;
    }

    function openFilters() {
      filterDrawer.classList.add('is-open');
      filterOverlay.classList.add('is-visible');

      document.body.style.overflow = 'hidden';
    }

    function closeFilters() {
      filterDrawer.classList.remove('is-open');
      filterOverlay.classList.remove('is-visible');

      document.body.style.overflow = '';
    }

    filterOpen.addEventListener('click', openFilters);

    filterClose.addEventListener('click', closeFilters);

    filterOverlay.addEventListener('click', closeFilters);

    window.addEventListener('resize', () => {
      if (window.innerWidth > 749) {
        closeFilters();
      }
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Main Collection",
  "settings": [],
  "presets": [
    {
      "name": "Main Collection"
    }
  ]
}
{% endschema %}
