{{ 'pagination.css' | asset_url | stylesheet_tag }}
<section class="blog-page">
  <div class="blog-page__container">
    <header class="blog-page__header">
      <h1 class="blog-page__title">
        {{ blog.title }}
      </h1>
    </header>

    {% paginate blog.articles by 4 %}
      <div class="blog-page__grid">
        {% for article in blog.articles %}
          <article class="blog-card">
            {% if article.image %}
              <a
                href="{{ article.url }}"
                class="blog-card__image"
              >
                {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000' }}
              </a>
            {% endif %}

            <div class="blog-card__content">
              <div class="blog-card__meta">
                {% assign date = article.published_at | time_tag: format: 'date' %}
                <span>{{ date }}</span>

                {% if article.author != blank %}
                  <span class="blog-card__separator">•</span>
                  <span>{{ article.author }}</span>
                {% endif %}
              </div>

              <h2 class="blog-card__title">
                <a href="{{ article.url }}">
                  {{ article.title }}
                </a>
              </h2>

              {% if article.excerpt != blank %}
                <div class="blog-card__excerpt">
                  {{ article.excerpt }}
                </div>
              {% else %}
                <div class="blog-card__excerpt">
                  {{ article.content | strip_html | truncate: 160 }}
                </div>
              {% endif %}

              <a
                href="{{ article.url }}"
                class="blog-card__link"
              >
                Read more
              </a>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">Previous</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}">
                {{ part.title }}
              </a>
            {% else %}
              <span>
                {{ part.title }}
              </span>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  .blog-page__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 60px;
    flex-wrap: wrap;
  }

  .blog-page__pagination a,
  .blog-page__pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    color: #111;
    background: #fff;
    text-decoration: none;
    font-size: 14px;
    line-height: 1;
    transition: all 0.2s ease;
  }

  .blog-page__pagination a:hover {
    background: #111;
    border-color: #111;
    color: #fff;
  }

  .blog-page__pagination span {
    background: #111;
    border-color: #111;
    color: #fff;
  }

  .blog-page__pagination a:first-child,
  .blog-page__pagination a:last-child {
    padding: 0 16px;
  }

  @media (max-width: 767px) {
    .blog-page__pagination {
      gap: 6px;
      margin-top: 40px;
    }

    .blog-page__pagination a,
    .blog-page__pagination span {
      min-width: 36px;
      height: 36px;
      padding: 0 9px;
      font-size: 13px;
    }

    .blog-page__pagination a:first-child,
    .blog-page__pagination a:last-child {
      padding: 0 12px;
    }
  }
  .blog-page {
    width: 100%;
    padding: 70px 0 90px;
  }

  .blog-page__container {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
  }

  .blog-page__header {
    margin-bottom: 50px;
    text-align: center;
  }

  .blog-page__title {
    margin: 0;
    font-size: 42px;
    line-height: 1.2;
    font-weight: 700;
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 50px 30px;
  }

  .blog-card {
    min-width: 0;
  }

  .blog-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f5f5f5;
  }

  .blog-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card__image:hover img {
    transform: scale(1.04);
  }

  .blog-card__content {
    padding-top: 20px;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: #777;
    font-size: 13px;
    line-height: 1.4;
  }

  .blog-card__separator {
    color: #aaa;
  }

  .blog-card__title {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 600;
  }

  .blog-card__title a {
    color: #111;
    text-decoration: none;
  }

  .blog-card__title a:hover {
    text-decoration: underline;
  }

  .blog-card__excerpt {
    margin-bottom: 18px;
    color: #666;
    font-size: 15px;
    line-height: 1.7;
  }

  .blog-card__link {
    display: inline-block;
    color: #111;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 767px) {
    .blog-page {
      padding: 45px 0 60px;
    }

    .blog-page__container {
      width: min(100% - 30px, 1200px);
    }

    .blog-page__header {
      margin-bottom: 30px;
    }

    .blog-page__title {
      font-size: 32px;
    }

    .blog-page__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .blog-card__title {
      font-size: 21px;
    }

    .blog-card__excerpt {
      font-size: 14px;
    }

    .blog-page__pagination {
      margin-top: 45px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "settings": [],
  "presets": [
    {
      "name": "Blog"
    }
  ]
}
{% endschema %}
