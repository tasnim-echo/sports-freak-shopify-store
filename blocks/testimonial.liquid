<div class="testimonial-card" {{ block.shopify_attributes }}>
  <div class="testimonial-reviewer">
    <div class="testimonial-avatar">
      {% if block.settings.avatar != blank %}
        {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-avatar' }}
      {% endif %}
    </div>

    <div class="testimonial-reviewer-info">
      {% if block.settings.name != blank %}
        <h3>{{ block.settings.name }}</h3>
      {% endif %}
    </div>
  </div>

  {% if block.settings.review != blank %}
    <div class="testimonial-review">
      <p>{{ block.settings.review }}</p>
    </div>
  {% endif %}

  {% if block.settings.date != blank %}
    <div class="testimonial-date">
      {{ block.settings.date }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Testimonial",
  "settings": [
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Reviewer avatar"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Reviewer name",
      "default": "Tasnim Mahmud"
    },
    {
      "type": "textarea",
      "id": "review",
      "label": "Review",
      "default": "Amazing product and excellent quality. I absolutely love it!"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Review date",
      "default": "November 21, 2026"
    }
  ],
  "presets": [
    {
      "name": "Testimonial"
    }
  ]
}
{% endschema %}
